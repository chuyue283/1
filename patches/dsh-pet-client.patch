+        fetch("/dsh-pet-7340/greet-now", { method: "POST", keepalive: true }).catch(function () {});
+      } catch (e) {}
+    };
+    var done = function () {
+      var el = document.querySelector(".dshba");
+      if (!el) { send(); return true; }
+      if (el.getAttribute("data-state") === "leaving") { send(); return true; }
+      return false;
+    };
+    if (done()) return;
+    var iv = setInterval(function () { if (done()) clearInterval(iv); }, 400);
+    setTimeout(function () { clearInterval(iv); send(); }, 60000);
+  } catch (e) {}
